    "image": "node scripts/image.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.1.2",

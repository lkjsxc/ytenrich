{
  "name": "ytenrich",
  "version": "0.2.12",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "check": "node scripts/check.ts",
    "smoke": "node scripts/build.ts && node scripts/smoke.ts && node scripts/smoke-browse.ts && node scripts/smoke-music.ts",
